{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:macroatlas:schema:evaluation-case-v1",
  "title": "MacroAtlas EvaluationCase v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "case_version", "case_family_id", "split", "case_type", "request",
    "query_variants", "expected_state", "relevant_candidate_ids", "forbidden_candidate_ids",
    "expected_match_status", "expected_fields", "required_evidence", "prohibited_actions",
    "excel_policy", "feedback_ref"
  ],
  "properties": {
    "case_id": {"$ref": "#/$defs/identifier"},
    "case_version": {"type": "integer", "minimum": 1},
    "case_family_id": {"$ref": "#/$defs/identifier"},
    "split": {"enum": ["development", "validation", "holdout"]},
    "case_type": {"enum": ["rankable", "near_match", "insufficient_evidence", "unrelated"]},
    "request": {"type": "object", "required": ["schema_version", "request_id", "text"]},
    "query_variants": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "expected_state": {"enum": ["candidate_found", "review_required", "unmatched"]},
    "relevant_candidate_ids": {"$ref": "#/$defs/candidateIdentifiers"},
    "forbidden_candidate_ids": {"$ref": "#/$defs/candidateIdentifiers"},
    "expected_match_status": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/candidateIdentifier"},
      "additionalProperties": {"enum": ["exact", "comparable", "related", "review_required"]}
    },
    "expected_fields": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/candidateIdentifier"},
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"$ref": "#/$defs/fieldExpectation"}
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_kind", "official_uri", "local_ref", "retrieved_at", "sha256", "claim"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/identifier"},
          "evidence_kind": {"enum": ["official_docs", "live_api", "live_ingestion", "fixture"]},
          "official_uri": {"type": "string", "format": "uri", "pattern": "^https://"},
          "local_ref": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "excel_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grouping", "incompatible_series", "overlap_conflict", "date_basis", "aggregation", "transformation", "missing_values", "interpolation", "forward_fill"],
      "properties": {
        "grouping": {"const": "one_series_per_sheet"},
        "incompatible_series": {"const": "separate_sheets"},
        "overlap_conflict": {"const": "preserve_separately_or_review"},
        "date_basis": {"const": "source_period"},
        "aggregation": {"const": "none"},
        "transformation": {"const": "none"},
        "missing_values": {"const": "blank"},
        "interpolation": {"const": "none"},
        "forward_fill": {"const": "none"}
      }
    },
    "feedback_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["feedback_id", "revision"],
          "properties": {
            "feedback_id": {"$ref": "#/$defs/identifier"},
            "revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "identifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "candidateIdentifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$"},
    "candidateIdentifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidateIdentifier"}},
    "fieldExpectation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"const": "known"}, "value": {}}},
        {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"const": "unknown"}}},
        {"type": "object", "additionalProperties": false, "required": ["state", "values"], "properties": {"state": {"const": "conflict"}, "values": {"type": "array", "minItems": 2}}}
      ]
    }
  }
}

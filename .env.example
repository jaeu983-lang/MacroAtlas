# Safe configuration template. Copy to .env locally and add your own secrets.
# Never commit .env or put real credentials in this file.
MACROATLAS_DATA_DIR=data
MACROATLAS_NETWORK_ENABLED=false

# Credentials for currently enabled key-backed sources.
BEA_API_KEY=
ESTAT_APP_ID=
FRED_API_KEY=

